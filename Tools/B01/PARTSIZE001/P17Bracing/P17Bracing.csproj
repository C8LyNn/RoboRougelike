<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Frozen original PARTSIZE producer's existing nullable annotations, not new P17 source. -->
    <NoWarn>$(NoWarn);CS8765;CS8629;CS8603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/PARTSIZE001/Runtime/PartSizeContract.cs" Link="FrozenPartSize/PartSizeContract.cs"/>
    <Compile Include="../../../../Assets/PARTSIZE001/Runtime/PartSizeBaselineCatalog.cs" Link="FrozenPartSize/PartSizeBaselineCatalog.cs"/>
    <Compile Include="../P17Rigs/RigValidator.cs" Link="FrozenP17/RigValidator.cs"/>
    <Compile Include="../P17Weakpoints/WeakpointEngine.cs" Link="FrozenWeakpoints/WeakpointEngine.cs"/>
  </ItemGroup>
</Project>
