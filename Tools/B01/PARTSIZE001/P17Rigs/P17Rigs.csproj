<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS8765;CS8629;CS8603</NoWarn>
    <!-- Original PartSizeContract.cs predates project-level nullable warnings.
         Suppress only its three pre-existing nullable diagnostics; never edit
         the original producer and keep all other warnings as errors. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the actual frozen producer runtime source. NEVER copy or shim its geometry. -->
    <Compile Include="../../../../Assets/PARTSIZE001/Runtime/PartSizeContract.cs" Link="Original/PartSizeContract.cs"/>
    <Compile Include="../../../../Assets/PARTSIZE001/Runtime/PartSizeBaselineCatalog.cs" Link="Original/PartSizeBaselineCatalog.cs"/>
  </ItemGroup>
</Project>
