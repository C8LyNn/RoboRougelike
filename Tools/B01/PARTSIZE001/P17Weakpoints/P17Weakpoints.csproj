<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Original frozen PARTSIZE source predates modern nullable annotations. -->
    <NoWarn>$(NoWarn);CS8765;CS8629;CS8603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/PARTSIZE001/Runtime/PartSizeContract.cs" Link="Frozen/PartSizeContract.cs"/>
    <Compile Include="../../../../Assets/PARTSIZE001/Runtime/PartSizeBaselineCatalog.cs" Link="Frozen/PartSizeBaselineCatalog.cs"/>
    <Compile Include="../P17Rigs/RigValidator.cs" Link="FrozenP17/RigValidator.cs"/>
  </ItemGroup>
</Project>
